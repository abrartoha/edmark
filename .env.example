# Supabase — create a project at https://supabase.com and paste the values here.
# Copy this file to .env.local and fill in your keys.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for SEO metadata, sitemap, canonical tags)
NEXT_PUBLIC_SITE_URL=https://edmark.com.au

# Resend — for email notifications when a new lead comes in
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key
